    "fetch:data": "tsx pipeline/fetch.ts",
    "build:data": "tsx pipeline/index.ts",
    "deploy": "npm run build:app"
  },
  "dependencies": {
    "flatbush": "^4.4.0",
    "flexsearch": "^0.7.43",
    "idb": "^8.0.0",
    "maplibre-gl": "^4.7.1",
    "ngraph.graph": "^20.0.1",
    "ngraph.path": "^1.5.0",
    "pmtiles": "^3.2.1"
  },
  "devDependencies": {
    "@turf/turf": "^7.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
