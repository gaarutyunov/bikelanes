{
  "name": "bikenav-malaga",
  "version": "1.2.0",
  "description": "Browser-only, client-side bike-lane navigation for Málaga (GitHub Pages).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "tsc --noEmit && vite build",
    "build": "npm run build:app",
    "preview": "vite preview",
